@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: #d9d9d9; font-family: 'Montserrat', sans-serif; color: #2b2b2b; }
body { padding: 30px 10px; }
.page {
  width: 210mm; min-height: 297mm; margin: 0 auto; background: #fff;
  display: grid; grid-template-columns: 38% 62%;
  box-shadow: 0 8px 30px rgba(0,0,0,.15);
}

/* ===== LEFT SIDEBAR ===== */
aside { display: flex; flex-direction: column; }
.photo { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; }
.dark {
  background: #1a1a1a; color: #fff; flex: 1;
  padding: 35px 30px 40px; display: flex; flex-direction: column; gap: 32px;
}
.block-title {
  text-align: center; font-weight: 400; font-size: 22px;
  letter-spacing: 6px; margin-bottom: 12px;
}
.rule { width: 60px; height: 2px; background: #b8b8b8; margin: 0 auto 16px; }
.profil p { text-align: center; font-size: 13px; line-height: 1.55; font-weight: 300; color: #e5e5e5; }

.contact ul { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-top: 4px; }
.contact li { display: flex; align-items: flex-start; gap: 12px; font-size: 12px; line-height: 1.45; font-weight: 300; color: #e5e5e5; }
.icon {
  flex: 0 0 22px; width: 22px; height: 22px; border-radius: 4px;
  background: #5a5a5a; display: inline-flex; align-items: center; justify-content: center;
  color: #fff; font-size: 12px;
}

.interests { margin-top: auto; }
.interests h3 { font-size: 13px; letter-spacing: 1.5px; font-weight: 500; margin-bottom: 8px; text-decoration: underline; }
.interests p { font-size: 13px; line-height: 1.7; font-weight: 300; color: #e5e5e5; }

/* ===== RIGHT MAIN ===== */
main { padding: 45px 45px 50px 35px; display: flex; flex-direction: column; gap: 28px; }

header h1 {
  font-size: 26px; font-weight: 600; letter-spacing: 1px; white-space: nowrap; color: #2b2b2b;
  text-align: center; line-height: 1.1;
}
header .role {
  text-align: center; font-size: 16px; letter-spacing: 8px; margin-top: 6px;
  font-weight: 400;
}
header .sub {
  text-align: center; font-size: 13px; letter-spacing: 4px; margin-top: 18px;
  line-height: 1.9; font-weight: 400; color: #2b2b2b;
}

.section-head {
  display: flex; align-items: center; justify-content: center; gap: 18px;
  margin: 6px 0 14px;
}
.section-head .bar { width: 70px; height: 3px; background: #b8b8b8; }
.section-head h2 {
  font-size: 18px; letter-spacing: 4px; font-weight: 400; white-space: nowrap;
}

.timeline { display: grid; grid-template-columns: 95px 1fr; row-gap: 14px; column-gap: 14px; font-size: 13px; }
.timeline .date { font-weight: 600; color: #4a4a4a; padding-top: 2px; }
.timeline .entry { color: #3a3a3a; line-height: 1.5; }
.timeline .entry .main-line { display: flex; gap: 6px; }
.timeline .entry ul { list-style: none; padding-left: 0; margin-top: 4px; }
.timeline .entry ul li { position: relative; padding-left: 14px; margin-top: 4px; }
.timeline .entry ul li::before { content: "•"; position: absolute; left: 0; color: #3a3a3a; }
.bullet::before { content: "•"; margin-right: 6px; }

.skills { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 30px; padding: 0 10px; font-size: 13px; }
.skills h4 { font-size: 14px; font-weight: 600; margin-bottom: 8px; letter-spacing: 0.5px; }
.skills p { line-height: 1.7; font-weight: 400; color: #2b2b2b; }
.skills .full { grid-column: 1 / -1; }

.exp-item { display: grid; grid-template-columns: 95px 1fr; column-gap: 14px; margin-bottom: 14px; }
.exp-item .date { font-weight: 600; color: #4a4a4a; font-size: 12px; padding-top: 2px; }
.exp-item .body h3 { font-size: 13px; font-weight: 700; letter-spacing: 1px; color: #1a1a1a; }
.exp-item .body ul { list-style: none; padding-left: 0; margin-top: 6px; }
.exp-item .body ul li { position: relative; padding-left: 14px; font-size: 13px; line-height: 1.55; }
.exp-item .body ul li::before { content: "•"; position: absolute; left: 0; }

@media print {
  body { background: #fff; padding: 0; }
  .page { box-shadow: none; }
}
